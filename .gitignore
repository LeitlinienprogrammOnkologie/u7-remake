godot/.godot/
godot/.vs/
godot/*.csproj.user
godot/.mono/
**/.DS_Store
Thumbs.db

# Original game data, Exult source and extracted assets are not tracked.
# See README.md for how to provide them.
/u7/
/exult/
/assets/
# Replacement FONTS.VGA files (unused; provenance and licence unknown).
/modern fonts/
# Saved games (Exult GAMEDAT layout)
/saves/
# Runtime stub-intrinsic report (BgIntrinsics.WriteStubReport)
/stub_report.txt
# Agent console I/O (scripts/agent/restart.ps1)
/agent_io/

# Poster pipeline output (renders of the game's map; regenerate with python -m u7poster.run)
/poster/
# Python bytecode
__pycache__/
# Hi-res art generator venv (scripts/upscale; see README)
.venv/

# Serpent Isle game data (GOG; Black Gate borrows its paperdolls, skins and shapes, Exult <SERPENT_STATIC>)
/serpent/
# Exult usecode compiler build (scripts/ucc/build.ps1)
/scripts/ucc/build/
/scripts/ucc/bin/
# The user's painted faces (scripts/faces/prepare.py makes them ready into assets/faces)
/u7-new-faces/
/si-new-faces/
# Serpent Isle voices made locally by scripts/bridge_speech.py
/mods/eighteen/data/u7speech.spc
